# API keys and settings for running finrec-bm against models.
# Copy this file to .env and fill in the keys for the providers you use.
# .env is git-ignored; never commit real keys. Blank values are ignored, and
# variables already set in the environment take precedence over this file.

# Model(s) to evaluate when --model isn't given: comma-separated model names
# (<provider>:<model id>), families (ds-flash, ds-v4pro, oa-luna, oa-sol, at-haiku, at-sonnet) or regexes. Leave it
# unset to run every listed model whose API key is set below.
# FINREC_MODEL=anthropic:claude-opus-5

# anthropic:<model id>, or a named model (no provider prefix):
# at-<haiku|sonnet>-<low|medium|high|max> (claude-haiku-5-5 or claude-sonnet-5-5
# at that effort); e.g. at-sonnet-high
ANTHROPIC_API_KEY=

# openai:<model id>, or a named model (no provider prefix):
# oa-luna-<none|low|medium|high|xhigh> (gpt-6-luna) or
# oa-sol-<low|medium|high|xhigh> (gpt-6.1-sol); e.g. oa-sol-high
OPENAI_API_KEY=

# google:<model id>
GEMINI_API_KEY=

# ds-<flash|v4p>-<off|low|high|max> (no provider prefix)
# flash = deepseek-flash, v4p = deepseek-v4-pro; e.g. ds-v4p-high
DEEPSEEK_API_KEY=
